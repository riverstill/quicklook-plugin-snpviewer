<?xml version="1.0" encoding="utf-8"?>
<!--
  Plugin metadata consumed by QuickLook's built-in PluginInstaller
  (spacebar on a .qlplugin file). Requirements, see
  QuickLook.Plugin/QuickLook.Plugin.PluginInstaller/PluginInfoPanel.xaml.cs:
    - This file MUST be named exactly "QuickLook.Plugin.Metadata.config"
      and sit at the zip root.
    - /Metadata/Namespace MUST start with "QuickLook.Plugin.", otherwise the
      installer shows "Invalid plugin." and hides the Install button.
    - /Metadata/Version is shown as "Version <...>"; missing => "not defined".
-->
<Metadata>
  <Namespace>QuickLook.Plugin.SnpViewer</Namespace>
  <Version>0.2.0</Version>
  <Description>Preview Touchstone S-parameter files (.s1p-.snp, .ts) as OxyPlot charts.</Description>
</Metadata>
