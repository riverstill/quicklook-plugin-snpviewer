<UserControl x:Class="QuickLook.Plugin.SnpViewer.SnpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:local="clr-namespace:QuickLook.Plugin.SnpViewer"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance local:SnpViewModel}"
             Background="{DynamicResource PanelBg}"
             Foreground="{DynamicResource PanelFg}"
             Loaded="SnpPanel_OnLoaded">
    <UserControl.Resources>
        <!-- Theme brushes. Dark values are the defaults; SnpPanel ctor swaps
             them for light values when Windows is in light app mode. -->
        <SolidColorBrush x:Key="PanelBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PanelFg" Color="#E0E0E0" />
        <SolidColorBrush x:Key="GridRowBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="GridAltRowBg" Color="#262626" />
        <SolidColorBrush x:Key="GridLine" Color="#333333" />
        <SolidColorBrush x:Key="GridHeaderBg" Color="#2D2D30" />
        <SolidColorBrush x:Key="GridHeaderFg" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TabCheckedBg" Color="#007ACC" />
        <SolidColorBrush x:Key="TabHoverBg" Color="#3E3E42" />
        <SolidColorBrush x:Key="WarningFg" Color="#E0A800" />
        <!-- Tracker (data-point tooltip) box colors, swapped per theme in code
             while the template itself stays fixed. -->
        <SolidColorBrush x:Key="TrackerBg" Color="#2D2D30" />
        <SolidColorBrush x:Key="TrackerBorder" Color="#808080" />
        <SolidColorBrush x:Key="TrackerFg" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TrackerCrosshair" Color="#808080" />

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridRowBg}" />
            <Setter Property="Foreground" Value="{DynamicResource PanelFg}" />
            <Setter Property="RowBackground" Value="{DynamicResource GridRowBg}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltRowBg}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}" />
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLine}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <!-- Flat pill look for the axis option radios. -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PanelFg}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,6"
                                Background="Transparent"
                                BorderBrush="{DynamicResource GridLine}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabCheckedBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabCheckedBg}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="380" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <!-- Header: waveform icon + big title + dimmed subtitle on the left,
             filename pill on the right. (Filename is also in the host title.) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M2,20 L8,20 L11,6 L17,34 L20,20 L26,20" Width="26" Height="22"
                      Stretch="Uniform" Stroke="{DynamicResource TabCheckedBg}"
                      StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" VerticalAlignment="Center" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="S-Parameters" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PanelFg}" />
                    <TextBlock x:Name="HeaderSubtitle" FontSize="12" Opacity="0.7"
                               Foreground="{DynamicResource PanelFg}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="8" Padding="12,7"
                    BorderBrush="{DynamicResource GridLine}" BorderThickness="1"
                    VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M4,0 H10 L14,4 V18 H4 Z M10,0 V4 H14" Width="13" Height="14"
                          Stretch="Uniform" Fill="{DynamicResource PanelFg}" Opacity="0.8"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="FilePillText" FontSize="12" Margin="7,0,0,0"
                               Foreground="{DynamicResource PanelFg}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Slim warning bar (only visible when the parser emitted warnings). -->
        <TextBlock x:Name="WarningBar" Grid.Row="1" Visibility="Collapsed"
                   TextWrapping="Wrap" Foreground="{DynamicResource WarningFg}"
                   FontSize="11" Margin="0,0,0,6" />
        <!-- Plot -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" CornerRadius="4" Padding="4">
            <oxy:PlotView x:Name="Plot">
                <!-- Tracker (hover tooltip) template. The stone-cold default
                     is a pale-yellow box whose TextBlock has no explicit
                     Foreground, so it inherits PanelFg (near-white in dark
                     mode) -> white-on-yellow, unreadable. Give it themed,
                     explicit colors via DynamicResource. -->
                <oxy:PlotView.DefaultTrackerTemplate>
                    <ControlTemplate>
                        <oxy:TrackerControl Position="{Binding Position}"
                                            LineExtents="{Binding PlotModel.PlotArea}"
                                            Background="{DynamicResource TrackerBg}"
                                            BorderBrush="{DynamicResource TrackerBorder}"
                                            BorderThickness="1"
                                            LineStroke="{DynamicResource TrackerCrosshair}">
                            <oxy:TrackerControl.Content>
                                <TextBlock Text="{Binding}" Margin="7"
                                           Foreground="{DynamicResource TrackerFg}" FontSize="12" />
                            </oxy:TrackerControl.Content>
                        </oxy:TrackerControl>
                    </ControlTemplate>
                </oxy:PlotView.DefaultTrackerTemplate>
            </oxy:PlotView>
        </Border>

        <!-- Axis options as pills in a rounded bar, Y group | X group -->
        <Border Grid.Row="3" CornerRadius="8" Padding="12,9"
                BorderBrush="{DynamicResource GridLine}" BorderThickness="1" Margin="0,8,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Y-axis:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PanelFg}" />
                <RadioButton x:Name="YDb" Content="dB" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YDb_OnChecked" />
                <RadioButton x:Name="YMagnitude" Content="Magnitude" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YMagnitude_OnChecked" />
                <RadioButton x:Name="YReal" Content="Real" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YReal_OnChecked" />
                <RadioButton x:Name="YImag" Content="Imaginary" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YImag_OnChecked" />
                <RadioButton x:Name="YPhase" Content="Phase (°)" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YPhase_OnChecked" />
                <Rectangle Width="1" Margin="12,2,12,2" Fill="{DynamicResource GridLine}" VerticalAlignment="Stretch" />
                <TextBlock Text="X-axis:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PanelFg}" />
                <RadioButton x:Name="XLinear" Content="Linear" GroupName="X" Style="{StaticResource TabRadio}" Checked="XLinear_OnChecked" />
                <RadioButton x:Name="XLog" Content="Log" GroupName="X" Style="{StaticResource TabRadio}" Checked="XLog_OnChecked" />
            </StackPanel>
        </Border>

        <!-- Data preview. NOTE: ItemsSource is assigned in code-behind
             (SyncDataGrid) to DataTable.DefaultView. Binding a DataTable
             object itself does not work - DataGrid needs the DataView. -->
        <DataGrid Grid.Row="4" x:Name="DataGrid"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  EnableRowVirtualization="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionUnit="FullRow" />
    </Grid>
</UserControl>
