<UserControl x:Class="QuickLook.Plugin.SnpViewer.SnpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:local="clr-namespace:QuickLook.Plugin.SnpViewer"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance local:SnpViewModel}"
             Background="{DynamicResource PanelBg}"
             Foreground="{DynamicResource PanelFg}"
             Loaded="SnpPanel_OnLoaded">
    <UserControl.Resources>
        <!-- Theme brushes. Dark values are the defaults; SnpPanel ctor swaps
             them for light values when Windows is in light app mode. -->
        <SolidColorBrush x:Key="PanelBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="PanelFg" Color="#E0E0E0" />
        <SolidColorBrush x:Key="GridRowBg" Color="#1E1E1E" />
        <SolidColorBrush x:Key="GridAltRowBg" Color="#262626" />
        <SolidColorBrush x:Key="GridLine" Color="#333333" />
        <SolidColorBrush x:Key="TabCheckedBg" Color="#007ACC" />
        <SolidColorBrush x:Key="TabHoverBg" Color="#3E3E42" />
        <SolidColorBrush x:Key="TabBg" Color="#2A2A2E" />
        <SolidColorBrush x:Key="WarningFg" Color="#E0A800" />
        <!-- Tracker (data-point tooltip) box colors, swapped per theme in code
             while the template itself stays fixed. -->
        <SolidColorBrush x:Key="TrackerBg" Color="#2D2D30" />
        <SolidColorBrush x:Key="TrackerBorder" Color="#808080" />
        <SolidColorBrush x:Key="TrackerFg" Color="#E0E0E0" />
        <SolidColorBrush x:Key="TrackerCrosshair" Color="#808080" />

        <!-- Flat pill look for the axis option radios. -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PanelFg}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="14,6"
                                Background="{DynamicResource TabBg}"
                                BorderBrush="{DynamicResource GridLine}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabCheckedBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabCheckedBg}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="380" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: waveform icon + big title + dimmed subtitle on the left,
             filename pill on the right. The whole row shares the same
             left/right inset as plot and options so all right edges align.
             The Y axis line (auto margin, ~96px from outer left) passes
             between the icon and the title text. -->
        <Grid Grid.Row="0" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="44,0,0,0">
                <Path Data="M2,20 L8,20 L11,6 L17,34 L20,20 L26,20" Width="32" Height="27"
                      Stretch="Uniform" Stroke="{DynamicResource TabCheckedBg}"
                      StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="-30,0,30,0" />
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="S-Parameters" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PanelFg}" />
                    <TextBlock x:Name="HeaderSubtitle" FontSize="12" Opacity="0.7"
                               Foreground="{DynamicResource PanelFg}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="8" Padding="12,10"
                    BorderBrush="{DynamicResource GridLine}" BorderThickness="1"
                    VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M5,0 H15 L21,6 V26 H5 Z M15,0 V6 H21" Width="18" Height="16"
                          Stretch="Uniform" Stroke="{DynamicResource PanelFg}" StrokeThickness="1.6"
                          Fill="Transparent" Opacity="0.8" VerticalAlignment="Center" />
                    <TextBlock x:Name="FilePillText" FontSize="12" Margin="7,0,0,0"
                               Foreground="{DynamicResource PanelFg}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Slim warning bar (only visible when the parser emitted warnings). -->
        <TextBlock x:Name="WarningBar" Grid.Row="1" Visibility="Collapsed"
                   TextWrapping="Wrap" Foreground="{DynamicResource WarningFg}"
                   FontSize="11" Margin="20,0,20,6" />
        <!-- Plot -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" CornerRadius="4" Padding="4,4,0,4"
                Margin="20,0,20,0">
            <oxy:PlotView x:Name="Plot">
                <!-- Tracker (hover tooltip) template. The stone-cold default
                     is a pale-yellow box whose TextBlock has no explicit
                     Foreground, so it inherits PanelFg (near-white in dark
                     mode) -> white-on-yellow, unreadable. Give it themed,
                     explicit colors via DynamicResource. -->
                <oxy:PlotView.DefaultTrackerTemplate>
                    <ControlTemplate>
                        <oxy:TrackerControl Position="{Binding Position}"
                                            LineExtents="{Binding PlotModel.PlotArea}"
                                            Background="{DynamicResource TrackerBg}"
                                            BorderBrush="{DynamicResource TrackerBorder}"
                                            BorderThickness="1"
                                            LineStroke="{DynamicResource TrackerCrosshair}">
                            <oxy:TrackerControl.Content>
                                <TextBlock Text="{Binding}" Margin="7"
                                           Foreground="{DynamicResource TrackerFg}" FontSize="12" />
                            </oxy:TrackerControl.Content>
                        </oxy:TrackerControl>
                    </ControlTemplate>
                </oxy:PlotView.DefaultTrackerTemplate>
            </oxy:PlotView>
        </Border>

        <!-- Axis options as pills in a rounded bar, Y group | X group -->
        <Border Grid.Row="3" CornerRadius="8" Padding="12,9"
                BorderBrush="{DynamicResource GridLine}" BorderThickness="1" Margin="20,8,20,8">
            <!-- Y group left, X group right, divider pinned to the exact
                 horizontal center via overlay (all three share one cell).
                 Narrow windows (<~700px) could overlap the groups; the
                 default 1150px window has ample room. -->
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="YAxisLabel" Text="Y轴：" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PanelFg}" />
                    <RadioButton x:Name="YDb" Content="dB" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YDb_OnChecked" />
                    <RadioButton x:Name="YMagnitude" Content="幅值" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YMagnitude_OnChecked" />
                    <RadioButton x:Name="YReal" Content="实部" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YReal_OnChecked" />
                    <RadioButton x:Name="YImag" Content="虚部" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YImag_OnChecked" />
                    <RadioButton x:Name="YPhase" Content="相位 (°)" GroupName="Y" Style="{StaticResource TabRadio}" Checked="YPhase_OnChecked" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="XAxisLabel" Text="X轴：" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PanelFg}" />
                    <RadioButton x:Name="XLinear" Content="线性" GroupName="X" Style="{StaticResource TabRadio}" Checked="XLinear_OnChecked" />
                    <RadioButton x:Name="XLog" Content="对数" GroupName="X" Style="{StaticResource TabRadio}" Checked="XLog_OnChecked" />
                </StackPanel>
                <Rectangle Width="1" Margin="0,7" Fill="{DynamicResource GridLine}"
                           HorizontalAlignment="Center" VerticalAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
